# --- Project ---
COMPOSE_PROJECT_NAME=mqlab
TZ=Europe/Madrid

# --- Image tags (pinned on purpose, not 'latest') ---
MOSQUITTO_TAG=2
HA_TAG=stable
PYTHON_TAG=3.12-slim
CAM_API_VERSION=0.1.0

# --- Run identities ---
MOSQ_UID=1883       
MOSQ_GID=1883
APP_UID=10001      
APP_GID=10001

# --- Host paths ---
# conf/ stays in the git repo and is mounted read-only; runtime state the
# containers write lives in a separate tree, outside git.
HOST_CONF_DIR=./conf     
HOST_DATA_DIR=/srv/lab-mosquitto/data
HOST_LOG_DIR=/srv/lab-mosquitto/log
HOST_HA_CONFIG_DIR=/srv/lab-mosquitto/ha-config

# --- Network (dedicated bridge) ---
# Containers live on an internal Docker subnet and talk by service name. The
# broker and HA are published ONLY on the VM's host-only IP (not 0.0.0.0), so
# Parrot can reach them without exposing them on the NAT interface.
LAB_NETWORK_NAME=mqlab-net
HOST_BIND_IP=192.168.183.10
MQTT_HOST=mosquitto       

# --- Ports ---
MQTT_PORT=1883
MQTTS_PORT=8883
HA_PORT=8123

# --- Container hostnames ---
MOSQUITTO_HOSTNAME=broker
HA_HOSTNAME=hass
CAM_API_HOSTNAME=cam-api

# --- Lab credentials ---
# Mosquitto does NOT read these from the env: it authenticates against
# conf/<scenario>/passwd. They are used by the healthcheck, the cam-api client,
# and the command that generates that passwd file.
HEALTH_USER=svc_health
HEALTH_PASSWORD=S3cret-health
HEALTH_TIMEOUT=5

CAM_API_USER=svc_cam
CAM_API_PASSWORD=S3cret-cam
CAM_API_CLIENT_ID=cam-api-01
CAM_API_TOPIC_PREFIX=cam
CAM_API_INTERVAL=5

# --- Resource limits ---
MOSQUITTO_MEM_LIMIT=128m
HA_MEM_LIMIT=2g   
CAM_API_MEM_LIMIT=128m

# --- Docker log rotation ---
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

